<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EstradaPlay" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#06140D</item>
        <item name="android:statusBarColor">#06140D</item>
        <item name="android:navigationBarColor">#06140D</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">#009C3B</item>
        <item name="android:alertDialogTheme">@style/Theme.EstradaPlay.Dialog</item>
    </style>

    <style name="Theme.EstradaPlay.Splash" parent="@style/Theme.EstradaPlay">
        <item name="android:windowBackground">@color/epc_splash_bg</item>
        <item name="android:statusBarColor">@color/epc_splash_bg</item>
        <item name="android:navigationBarColor">@color/epc_splash_bg</item>
        <item name="android:windowDisablePreview">false</item>
    </style>

    <style name="Theme.EstradaPlay.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@drawable/estradaplay_dialog_background</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">88%</item>
        <item name="android:windowElevation">24dp</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.72</item>
        <item name="android:textColorPrimary">#F4F7FB</item>
        <item name="android:textColorSecondary">#9CB0A3</item>
        <item name="android:colorAccent">#009C3B</item>
        <item name="android:listDivider">@android:color/transparent</item>
        <item name="android:windowNoTitle">false</item>
    </style>
</resources>
